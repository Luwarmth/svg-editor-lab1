{
  "name": "svg-editor-lab1",
  "version": "0.1.0",
  "private": true,
  "description": "Object-oriented SVG command-line editor for Lab1 Phase 1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "npm run build --silent && node dist/src/main.js",
    "test": "npm run build --silent && node --test dist/tests/*.test.js",
    "check:architecture": "node scripts/check-architecture.cjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
